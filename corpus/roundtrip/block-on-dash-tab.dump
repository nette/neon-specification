DocumentNode
	value: BlockArrayNode
		items:
			- ArrayItemNode
				bullet: Dash "-" >[Whitespace " "]
				value: BlockArrayNode
					items:
						- ArrayItemNode
							key: LiteralNode
								token: Literal "a"
							colon: Colon ":" >[Whitespace " "]
							value: LiteralNode
								token: Literal "1" >[LineEnding "\n"]
						- ArrayItemNode
							key: LiteralNode
								token: Literal "b" <[Whitespace "\t"]
							colon: Colon ":" >[Whitespace " "]
							value: LiteralNode
								token: Literal "2" >[LineEnding "\n"]
			- ArrayItemNode
				bullet: Dash "-" >[Whitespace " "]
				value: BlockArrayNode
					items:
						- ArrayItemNode
							bullet: Dash "-" >[Whitespace " "]
							value: LiteralNode
								token: Literal "c" >[LineEnding "\n"]
						- ArrayItemNode
							bullet: Dash "-" <[Whitespace "\t"] >[Whitespace " "]
							value: LiteralNode
								token: Literal "d" >[LineEnding "\n"]
	endOfFile: EndOfFile ""
