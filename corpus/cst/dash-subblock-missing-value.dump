DocumentNode
	value: BlockArrayNode
		items:
			- ArrayItemNode
				key: LiteralNode
					token: Literal "a"
				colon: Colon ":" >[LineEnding "\n"]
				value: BlockArrayNode
					items:
						- ArrayItemNode
							bullet: Dash "-" >[Whitespace " "]
							value: LiteralNode
								token: Literal "b" >[LineEnding "\n"]
			- ArrayItemNode
				key: LiteralNode
					token: Literal "c"
				colon: Colon ":"
	endOfFile: EndOfFile ""
